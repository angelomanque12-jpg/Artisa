# Referencia de las variables; genera .env con python3 scripts/prepare_env.py.
MARIADB_DATABASE=artisa
MARIADB_USER=artisa_app
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=
# Generadas localmente por scripts/prepare_env.py; no guardar secretos aquí.
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=
JWT_SECRET=
JWT_TTL_SECONDS=43200
MONGO_URI=mongodb://mongodb:27017
MONGO_DATABASE=gps_data
MONGO_COLLECTION=raw_gps
MONGO_TIMEOUT_SECONDS=10
TELEMETRY_BATCH_SIZE=2000
TELEMETRY_INTERVAL_SECONDS=30
# API de la empresa (telemetría actual). Solo funciona conectado a la red de la empresa.
# Déjala vacía para que la web siga mostrando "pendiente". No pongas tokens reales aquí:
# configúralos solo en .env.
COMPANY_API_URL=
COMPANY_API_TOKEN=
COMPANY_API_TABLE=reportes
# "auto" detecta la hora del origen comparándola con el reloj de este equipo.
COMPANY_API_TIMEZONE=auto
COMPANY_API_INTERVAL_SECONDS=30
COMPANY_API_OVERLAP_SECONDS=300
COMPANY_API_INITIAL_LOOKBACK_HOURS=24
# Solo la primera conexión: desde cuándo traer reportes (hora de Chile). Para empalmar
# con el histórico (termina el 2026-09-08 23:59 UTC) usa 2026-09-08 20:00.
# Se configura con: python3 scripts/artisa.py conectar-api URL --desde "AAAA-MM-DD HH:MM"
COMPANY_API_START=
COMPANY_API_RETRY_MAX_SECONDS=60
# Cierre diario: zona del corte de las 00:00 y, opcional, desde qué día procesar
# (vacío = desde el primer día con datos, del histórico o de la API).
ARTISA_TIMEZONE=America/Santiago
DIARIO_DESDE=
# Hora (Chile) del trabajo diario: cerrar días, recalcular atrasados y clasificar rutas.
# Vacío = continuo. Ejecutar a mano: python3 scripts/artisa.py cierre
DIARIO_HORA=00:30
# 1 = también carga el JSON histórico con MongoDB + ETL (desarrollo). 0 = solo API de la empresa.
ETL_HISTORICO=1
# Acceso a la web: 127.0.0.1 = solo este equipo; 0.0.0.0 = desde la red (servidor).
ARTISA_BIND=127.0.0.1
ARTISA_PORT=8080
# Respaldo diario de MariaDB en la carpeta respaldos/ (hora de Chile) y cuántos días guardar.
RESPALDO_HORA=03:00
RESPALDO_DIAS=3
# Asistente de la web: clave gratuita de Google AI Studio (https://aistudio.google.com/apikey).
# Ponla solo en .env, nunca aquí. Vacía = el chat avisa que no está configurado.
GEMINI_API_KEY=
# Vacío = gemini-flash-latest.
GEMINI_MODEL=
